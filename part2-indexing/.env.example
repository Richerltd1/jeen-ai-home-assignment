# Copy to .env and fill in. .env is gitignored and must never be committed.

# Google AI Studio API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# PostgreSQL connection string. The database must have the pgvector extension available.
# Local (docker compose up -d):
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/docdex
# Supabase / other hosted Postgres:
# POSTGRES_URL=postgresql://user:password@host:5432/postgres?sslmode=require
